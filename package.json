{
  "name": "dsh-sprite-studio",
  "version": "0.22.3",
  "private": true,
  "description": "Canvas workspace for sprite sheets in DeepSeek Harness: slice, matte, compose LPC characters, generate seamless backgrounds and effects, export atlases. 画布式精灵图工作台。",
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sprite",
    "spritesheet",
    "canvas",
    "matting",
    "pixel-art",
    "lpc",
    "game-dev",
    "atlas"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhang66633/dsh-sprite-studio.git"
  },
  "homepage": "https://github.com/zhang66633/dsh-sprite-studio#readme",
  "bugs": {
    "url": "https://github.com/zhang66633/dsh-sprite-studio/issues"
  },
  "author": "zhang66633"
}
